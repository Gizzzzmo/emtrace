CompileFlags:
  Add:
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wconversion
    - -Wmissing-prototypes
  Remove: -W*
  CompilationDatabase: build/
Hover:
  MacroContentsLimit: 4096
Documentation:
  CommentFormat: Doxygen
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: None
  ClangTidy:
    FastCheckFilter: Strict
